<mvc:View
  controllerName="com.portoseguro.dashboard.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
  displayBlock="true">

  <Shell>
    <App id="dashApp">
      <pages>
        <Page
          id="dashPage"
          showHeader="true"
          backgroundDesign="List">

          <customHeader>
            <Bar>
              <contentLeft>
                <Title text="Porto Seguro – Dashboard Executivo" level="H4"/>
              </contentLeft>
              <contentRight>
                <Button
                  text="Gestão de Clientes"
                  icon="sap-icon://customer"
                  type="Transparent"
                  press=".onNavigateToCustomers"/>
              </contentRight>
            </Bar>
          </customHeader>

          <content>
            <VBox class="sapUiMediumMargin">

              <!-- ── KPI Tiles ─────────────────────────────────────── -->
              <Title text="Visão Geral da Carteira" level="H3" class="sapUiSmallMarginBottom"/>

              <l:Grid
                defaultSpan="XL3 L3 M6 S12"
                class="sapUiSmallMarginBottom">

                <GenericTile
                  header="Total Classificados"
                  subheader="Clientes com perfil de risco"
                  press=".onNavigateToCustomers"
                  frameType="TwoByOne">
                  <tileContent>
                    <TileContent>
                      <content>
                        <NumericContent
                          value="{dashModel>/kpis/total}"
                          indicator="None"
                          withMargin="false"/>
                      </content>
                    </TileContent>
                  </tileContent>
                </GenericTile>

                <GenericTile
                  header="Críticos"
                  subheader="Requerem ação imediata"
                  frameType="TwoByOne">
                  <tileContent>
                    <TileContent>
                      <content>
                        <NumericContent
                          value="{dashModel>/kpis/critico}"
                          indicator="None"
                          valueColor="Critical"
                          withMargin="false"/>
                      </content>
                    </TileContent>
                  </tileContent>
                </GenericTile>

                <GenericTile
                  header="Alto Risco"
                  subheader="Monitoramento prioritário"
                  frameType="TwoByOne">
                  <tileContent>
                    <TileContent>
                      <content>
                        <NumericContent
                          value="{dashModel>/kpis/alto}"
                          indicator="None"
                          valueColor="Critical"
                          withMargin="false"/>
                      </content>
                    </TileContent>
                  </tileContent>
                </GenericTile>

                <GenericTile
                  header="Revisão Pendente"
                  subheader="Vence em até 30 dias"
                  frameType="TwoByOne">
                  <tileContent>
                    <TileContent>
                      <content>
                        <NumericContent
                          value="{dashModel>/kpis/reviewPending}"
                          indicator="None"
                          valueColor="Neutral"
                          withMargin="false"/>
                      </content>
                    </TileContent>
                  </tileContent>
                </GenericTile>

              </l:Grid>

              <!-- ── Chart + Table ────────────────────────────────── -->
              <l:HorizontalLayout allowWrapping="true" class="sapUiSmallMarginTop">

                <!-- Donut Chart -->
                <Panel
                  headerText="Distribuição por Nível de Risco"
                  width="420px"
                  class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                  <viz:VizFrame
                    id="riskChart"
                    vizType="donut"
                    height="320px"
                    width="100%"
                    uiConfig="{applicationSet:'fiori'}"
                    vizProperties="{
                      general: { animated: true },
                      legend: { visible: true, position: 'right' },
                      title: { visible: false },
                      plotArea: {
                        colorPalette: ['#188918','#E9730C','#E4002B','#BB0000']
                      }
                    }">
                    <viz:dataset>
                      <vizData:FlattenedDataset data="{dashModel>/chartData}">
                        <vizData:dimensions>
                          <vizData:DimensionDefinition
                            name="Nível de Risco"
                            value="{riskLabel}"/>
                        </vizData:dimensions>
                        <vizData:measures>
                          <vizData:MeasureDefinition
                            name="Quantidade"
                            value="{count}"/>
                        </vizData:measures>
                      </vizData:FlattenedDataset>
                    </viz:dataset>
                    <viz:feeds>
                      <vizFeeds:FeedItem
                        uid="color"
                        type="Dimension"
                        values="Nível de Risco"/>
                      <vizFeeds:FeedItem
                        uid="size"
                        type="Measure"
                        values="Quantidade"/>
                    </viz:feeds>
                  </viz:VizFrame>
                </Panel>

                <!-- Top Critical Clients -->
                <Panel
                  headerText="Clientes Críticos e Alto Risco"
                  expandable="false"
                  width="auto"
                  class="sapUiSmallMarginBottom"
                  backgroundDesign="Transparent">
                  <Table
                    id="criticalTable"
                    items="{dashModel>/criticalClients}"
                    alternateRowColors="true"
                    noDataText="Nenhum cliente crítico ou de alto risco."
                    growing="true"
                    growingThreshold="10">
                    <columns>
                      <Column width="130px"><Text text="Código BP"/></Column>
                      <Column width="100px"><Text text="Nível"/></Column>
                      <Column width="120px"><Text text="Segmento"/></Column>
                      <Column width="140px"><Text text="Responsável"/></Column>
                      <Column width="110px"><Text text="Revisão"/></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <ObjectIdentifier title="{dashModel>businessPartner}"/>
                          <ObjectStatus
                            text="{dashModel>riskLevel}"
                            state="{dashModel>riskState}"/>
                          <Text text="{dashModel>segment}"/>
                          <Text text="{dashModel>owner}"/>
                          <Text text="{dashModel>reviewDate}"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </Panel>

              </l:HorizontalLayout>
            </VBox>
          </content>

        </Page>
      </pages>
    </App>
  </Shell>
</mvc:View>
