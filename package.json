{
  "name": "porto-seguro-customer-ext",
  "version": "1.0.0",
  "description": "Porto Seguro – Extensão de Clientes S/4HANA via SAP BTP",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/hana": "^3.0.2",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^10.0.5",
    "@sap/xssec": "^4",
    "express": "^4",
    "hdb": "^0.19",
    "passport": "^0.7"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.0.7",
    "cds-plugin-ui5": "^0"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build:cf": "cds build --production"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": {
          "kind": "hana-cloud"
        }
      },
      "auth": {
        "kind": "dummy",
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[hybrid]": {
          "credentials": {
            "destination": "s4hc-knq-api-bp"
          }
        },
        "[production]": {
          "credentials": {
            "destination": "s4hc-knq-api-bp"
          }
        }
      }
    },
    "sql.native_hana_associations": false
  }
}
