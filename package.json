{
  "name": "insurance-policies",
  "version": "1.0.0",
  "private": true,
  "description": "Porto Seguro — Gestão de Apólices e Sinistros (CAP + Fiori Elements + RAG)",
  "scripts": {
    "start": "node node_modules/@sap/cds/bin/serve.js",
    "watch": "node node_modules/@sap/cds/bin/serve.js",
    "watch:hana": "cds bind --exec --profile hybrid -- node node_modules/@sap/cds/bin/serve.js --profile hybrid",
    "start:hana": "cds bind --exec --profile hybrid -- node node_modules/@sap/cds/bin/serve.js --profile hybrid",
    "deploy:hana": "node node_modules/@sap/cds-dk/bin/cds.js deploy --to hana:insurance-policies-db --profile hybrid --for hybrid --auto-undeploy",
    "test": "node --test test/*.test.js",
    "watch-policy-management": "node node_modules/@sap/cds/bin/serve.js",
    "open-fiori": "node node_modules/@sap/cds/bin/serve.js",
    "watch-claims-management": "node node_modules/@sap/cds/bin/serve.js"
  },
  "dependencies": {
    "@sap-ai-sdk/foundation-models": "^2.11.0",
    "@sap/cds": "^9.9.1",
    "axios": "^1.7.9",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      }
    },
    "[hybrid]": {
      "requires": {
        "db": {
          "kind": "hana",
          "model": [
            "db",
            "db/hana"
          ]
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "hana",
          "model": [
            "db",
            "db/hana"
          ]
        },
        "auth": "xsuaa"
      }
    },
    "server": {
      "bodyParser": {
        "limit": "50mb"
      }
    },
    "i18n": {
      "default_language": "pt"
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/policy-management",
    "app/claims-management"
  ]
}
